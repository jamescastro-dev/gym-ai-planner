# Frontend environment variables (Vite). Copy this file to `.env` and fill in the values.
# VITE_* values are public: they are compiled into the browser bundle, so never put secrets here.

# Base URL of the backend API (no trailing slash).
#   Local backend:  http://localhost:3001
#   Hosted backend: your Render URL, e.g. https://gym-ai-planner.onrender.com
VITE_API_URL=http://localhost:3001

# Neon Auth URL: Neon Console -> your project -> Auth -> Configuration.
VITE_NEON_AUTH_URL=https://ep-xxxxxxxx.neonauth.<region>.aws.neon.tech/neondb/auth
