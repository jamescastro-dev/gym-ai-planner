# Backend environment variables. Copy this file to `server/.env` and fill in the values.
# On Render, set the same variables under Environment instead of using a file.

# ── Required ─────────────────────────────────────────────────────────────────

# Neon Postgres connection string (Neon Console -> Connect). The pooled "-pooler" host is fine.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# OpenRouter API key: https://openrouter.ai/settings/keys
OPEN_ROUTER_KEY=sk-or-v1-...

# Same value as the frontend's VITE_NEON_AUTH_URL. The server uses it to verify sign-in tokens
# (it fetches the public keys from <NEON_AUTH_URL>/.well-known/jwks.json).
# Required: without it every /api request is rejected.
NEON_AUTH_URL=https://ep-xxxxxxxx.neonauth.<region>.aws.neon.tech/neondb/auth

# ── Optional ─────────────────────────────────────────────────────────────────

# Expected `iss` claim of sign-in tokens. Defaults to the origin of NEON_AUTH_URL (e.g. https://ep-xxxx.neonauth.<region>.aws.neon.tech).
# Only set this if the server log shows `unexpected "iss" claim value` and tells you what the tokens really claim.
# NEON_AUTH_ISSUER=

# Ordered, comma-separated OpenRouter models. Each one MUST end in ":free" (anything else is ignored).
# At most 3 requests are made per plan; if a model returns 404/429, empty output or invalid JSON,
# the next model is tried. Pick slugs from https://openrouter.ai/api/v1/models and test them first.
# Free models get removed or rate-limited from time to time, which is why this isn't hard-coded.
# Tested 2026-10-12 (4-day plan, one run each): nemotron-3-super 28s, apodex-1.1-mini 31s,
# gemma-4-26b-a4b-it 45s, gemma-4-31b-it 62s, dots-3-note-preview 89s (too slow).
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,apodex/apodex-1.1-mini:free,google/gemma-4-26b-a4b-it:free

# Comma-separated browser origins allowed to call the API (add your custom domain here).
ALLOWED_ORIGINS=https://gym-ai-planner.vercel.app,http://localhost:5173,http://localhost:3000

# Port to listen on (Render sets this itself).
PORT=3001

# Public URL of this server; only sent to OpenRouter as the HTTP-Referer header.
BASE_URL=http://localhost:3001

# ── Limits (defaults shown) ──────────────────────────────────────────────────

# Plans one user can create per rolling 24h (stored in the database).
PLANS_PER_USER_PER_DAY=3
# Plan requests per IP per day (in-memory; resets when the server restarts).
GENERATE_REQUESTS_PER_IP_PER_DAY=10
# Meal plans one user can create per rolling 24h (in-memory; resets when the server restarts).
MEAL_PLANS_PER_USER_PER_DAY=2
# Meal-plan requests per IP per day (in-memory; separate from the plan limit).
MEAL_REQUESTS_PER_IP_PER_DAY=6
# OpenRouter requests the server will make per UTC day, shared by plans and meal plans, kept under OpenRouter's free limit of 50.
AI_DAILY_BUDGET=45
# Reverse proxies in front of the server, so per-IP limits see the visitor's IP. After deploying, check the
# "[proxy-check]" line in the logs: req.ip should be a visitor's address, not your host's proxy.
TRUST_PROXY_HOPS=1
